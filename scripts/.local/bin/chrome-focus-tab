#!/bin/bash
# chrome-focus-tab <url>: focus an existing Chrome tab whose URL starts with
# <url> (so /files, #discussion etc. still match); open a new tab only if
# none matches. Used by tmux-open-pr. First run asks once for permission to
# control Chrome (System Settings > Privacy & Security > Automation).
set -uo pipefail
[ $# -eq 1 ] || { echo "usage: chrome-focus-tab <url>" >&2; exit 2; }

/usr/bin/osascript - "$1" <<'EOF'
on run argv
	set theUrl to item 1 of argv
	tell application "Google Chrome"
		if it is running then
			set wIdx to 0
			repeat with w in windows
				set wIdx to wIdx + 1
				set tIdx to 0
				repeat with t in tabs of w
					set tIdx to tIdx + 1
					if URL of t starts with theUrl then
						set active tab index of w to tIdx
						set index of w to 1
						activate
						return "focused"
					end if
				end repeat
			end repeat
		end if
		open location theUrl
		activate
	end tell
	return "opened"
end run
EOF
